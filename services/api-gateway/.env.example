# Copy to .env for local (non-Docker) runs. In docker-compose.phase2.yml
# these are set on the api-gateway service directly.

PORT=4000
CORS_ORIGIN=*

# The gateway is the ONLY service that holds these. It verifies incoming
# JWTs on every request and turns them into X-User-Id / X-Is-Admin /
# X-User-Name headers for downstream services. Must match auth-service's
# JWT_SECRET (auth-service signs, the gateway verifies).
JWT_SECRET=change-this-to-a-long-random-string

# Frontend-facing config, served by GET /api/config (this is frontend
# configuration, not a backend domain concern, so it lives on the gateway).
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_EMBED_KEY=

# Downstream services - reachable by container name on the Docker network.
# Localhost fallbacks are for running everything by hand outside Docker.
AUTH_SERVICE_URL=http://localhost:4001
DESTINATIONS_SERVICE_URL=http://localhost:4002
SEARCH_SERVICE_URL=http://localhost:4003
ITINERARY_SERVICE_URL=http://localhost:4004
RECOMMENDATION_SERVICE_URL=http://localhost:4005
CHATBOT_SERVICE_URL=http://localhost:4006
