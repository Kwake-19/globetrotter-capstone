# Copy to .env for local (non-Docker) runs.

PORT=4004
CORS_ORIGIN=*
DB_FILE=./data/itineraries.json

# Needed to (1) validate destinationIds when an itinerary is created or
# edited, and (2) enrich a shared itinerary with each stop's full
# destination details. If it's unreachable, those two operations return
# 503; the rest of the service still works.
DESTINATIONS_SERVICE_URL=http://localhost:4002
