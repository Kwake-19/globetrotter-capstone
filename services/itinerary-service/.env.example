# Copy this file to .env and adjust values as needed.

PORT=4002

# Must match user-service's JWT_SECRET - this service verifies tokens it
# didn't issue itself.
JWT_SECRET=change-this-to-a-long-random-string

DB_FILE=./data/db.json
CORS_ORIGIN=*

# Base URL of the Recommendation Service - called synchronously (REST) to
# validate destinationIds and to enrich shared itineraries with place details.
RECOMMENDATION_SERVICE_URL=http://localhost:4003

# RabbitMQ connection string - used to publish itinerary.created /
# itinerary.updated events. If unreachable, this service logs a warning and
# keeps working; publishing events is best-effort, never blocking on the
# request path.
RABBITMQ_URL=amqp://localhost:5672
