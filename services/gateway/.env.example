# Copy this file to .env and adjust values as needed.

PORT=4000

# Where each backend service lives. In docker-compose.phase2.yml these are
# the container/service names; for local (non-Docker) dev, point them at
# localhost with each service's own PORT.
USER_SERVICE_URL=http://localhost:4001
ITINERARY_SERVICE_URL=http://localhost:4002
RECOMMENDATION_SERVICE_URL=http://localhost:4003

CORS_ORIGIN=*

# Same non-secret frontend config Phase 1 served from GET /api/config.
GOOGLE_MAPS_EMBED_KEY=
