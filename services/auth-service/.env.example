# Copy to .env for local (non-Docker) runs.

PORT=4001
CORS_ORIGIN=*
DB_FILE=./data/users.json

# auth-service SIGNS the JWTs (login / register / google). Must be the
# same value as the gateway's JWT_SECRET, which VERIFIES them.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# Needed to verify the Google Identity Services credential in
# POST /api/auth/google. Without it that endpoint returns 503 and the rest
# of auth still works. Same client ID the gateway serves to the frontend
# via GET /api/config.
GOOGLE_CLIENT_ID=
