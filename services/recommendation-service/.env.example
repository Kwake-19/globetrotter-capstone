# Copy to .env for local (non-Docker) runs.

PORT=4005
CORS_ORIGIN=*

# This service has NO local data. It reads the destination catalog from
# destinations-service, and (for a logged-in user) that user's itineraries
# from itinerary-service, then ranks in memory - exactly what the
# monolith's single recommendations route did against local arrays.
#
# destinations-service unreachable -> 503 (can't recommend without a
# catalog). itinerary-service unreachable -> falls back to non-personalized
# results, still 200.
DESTINATIONS_SERVICE_URL=http://localhost:4002
ITINERARY_SERVICE_URL=http://localhost:4004
