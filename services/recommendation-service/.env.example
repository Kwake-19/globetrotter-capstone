# Copy this file to .env and adjust values as needed.

PORT=4003

# Must match user-service's JWT_SECRET - used for optional auth on
# /api/recommendations (personalized if logged in, popular otherwise).
JWT_SECRET=change-this-to-a-long-random-string

DB_FILE=./data/db.json
CORS_ORIGIN=*

# Base URL of the Itinerary Service - called synchronously (REST) to fetch
# the logged-in user's itineraries when personalizing recommendations. The
# incoming request's own Authorization header is forwarded, so Itinerary
# Service can verify it independently.
ITINERARY_SERVICE_URL=http://localhost:4002

# RabbitMQ connection string - this service consumes itinerary.created /
# itinerary.updated events to keep a `timesAdded` popularity counter on
# each destination, an example of asynchronous, eventually-consistent
# communication between services. If unreachable at startup, this service
# logs a warning and keeps retrying in the background rather than crashing.
RABBITMQ_URL=amqp://localhost:5672

# Optional. Powers GET /api/search (natural-language destination search).
GROQ_API_KEY=
