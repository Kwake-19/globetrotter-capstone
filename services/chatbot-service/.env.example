# Copy to .env for local (non-Docker) runs.

PORT=4006
CORS_ORIGIN=*

# The chatbot calls search-service (NOT destinations-service directly) to
# turn the user's message into a short list of suggested places.
SEARCH_SERVICE_URL=http://localhost:4003

# chatbot-service keeps its OWN OpenRouter credentials, independent of
# search-service's. You can copy the same key value into both - just don't
# make this service depend on search-service's env vars. Without a key,
# the chatbot still replies with a plain templated answer built from the
# suggested places.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
