# Copy to .env for local (non-Docker) runs.

PORT=4003
CORS_ORIGIN=*

# This service has NO local data. On every search it fetches the current
# destination list from destinations-service and ranks it in memory.
DESTINATIONS_SERVICE_URL=http://localhost:4002

# Optional. Powers GET /api/destinations/smart-search (AI query parsing)
# via OpenRouter's free tier. Without it, smart-search falls back to the
# synonym table only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Optional. Powers GET /api/search (the older Groq-backed natural-language
# search used by the itinerary builder). Without it, that route degrades
# to plain substring search.
GROQ_API_KEY=
