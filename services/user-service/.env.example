# Copy this file to .env and adjust values as needed.
# .env is git-ignored - never commit real secrets.

PORT=4001

# Must be the SAME value across user-service, itinerary-service and
# recommendation-service - all three verify JWTs issued by this service.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to this service's own JSON "database" file.
DB_FILE=./data/db.json

CORS_ORIGIN=*
