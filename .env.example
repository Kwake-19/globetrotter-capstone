# Copy this file to .env and adjust values as needed.
# .env is git-ignored - never commit real secrets.

PORT=4001

# Secret used to sign JWTs. Change this to a long random string in real deployments.
JWT_SECRET=change-this-to-a-long-random-string
# Default token lifetime (used when the "Remember me" checkbox is unchecked).
JWT_EXPIRES_IN=7d
# Token lifetime when "Remember me on this device" is checked at login/signup.
JWT_REMEMBER_EXPIRES_IN=30d

# Path to the JSON "database" file, relative to the project root.
DB_FILE=./data/db.json

# Comma-separated list of origins allowed to call this API from a browser.
# Use * only for local development.
CORS_ORIGIN=*

# Optional. Only needed to run scripts/enrich-places.js (a manual, one-off
# script - the running server never requires this). Requires a Google Cloud
# project with the Places API enabled and billing attached.
GOOGLE_PLACES_API_KEY=

# Optional. Powers the embedded map + directions on the place detail page
# (served to the frontend via GET /api/config). Requires the "Maps Embed
# API" enabled on the same Google Cloud project as Places. Without it, the
# page shows a "Map unavailable" placeholder instead of a broken iframe.
# Restrict this key by HTTP referrer in Google Cloud Console before using
# it beyond local dev.
GOOGLE_MAPS_EMBED_KEY=

# Optional. Powers GET /api/destinations/smart-search (AI natural-language
# search) via OpenRouter's free tier - https://openrouter.ai/keys, no card
# required. Without it, smart-search transparently falls back to the same
# plain keyword search as GET /api/destinations?q=. See the "AI-powered
# search" section in README.md for rate limits and setup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Optional. Powers "Sign in with Google" (POST /api/auth/google, plus the
# Google button on the login/signup pages, served to the frontend via
# GET /api/config). Create an OAuth 2.0 Client ID (type "Web application")
# in Google Cloud Console and put its client ID here. Without it, the
# Google button just doesn't render - the existing email/username login
# still works fully either way.
GOOGLE_CLIENT_ID=
