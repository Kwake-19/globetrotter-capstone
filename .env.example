# Copy this file to .env and adjust values as needed.
# .env is git-ignored - never commit real secrets.

PORT=4001

# Secret used to sign JWTs. Change this to a long random string in real deployments.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to the JSON "database" file, relative to the project root.
DB_FILE=./data/db.json

# Comma-separated list of origins allowed to call this API from a browser.
# Use * only for local development.
CORS_ORIGIN=*

# Optional. Only needed to run scripts/enrich-places.js (a manual, one-off
# script - the running server never requires this). Requires a Google Cloud
# project with the Places API enabled and billing attached.
GOOGLE_PLACES_API_KEY=

# Optional. Powers the embedded map + directions on the place detail page
# (served to the frontend via GET /api/config). Requires the "Maps Embed
# API" enabled on the same Google Cloud project as Places. Without it, the
# page shows a "Map unavailable" placeholder instead of a broken iframe.
# Restrict this key by HTTP referrer in Google Cloud Console before using
# it beyond local dev.
GOOGLE_MAPS_EMBED_KEY=
